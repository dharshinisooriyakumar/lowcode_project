/*
 * Author       : dharshini.s.2024.cse_raja
 * Generated on : 10-Nov-2026 08:50:40
 * Version      : 1.0
 */
 application "assignment _hotelform"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Room_Booking_Form
		{
			success message = "Hotel Booked Successfully!\\n"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Guest_name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Email_Address
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Permanent_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			ID_Proof_Number
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Special_Requests
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Number_Of_Guests
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Check_In_Date
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_CheckIn_Time
			(
    			type = time
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Room_Type
			(
				type = picklist
				maxchar = 100
				values = {"Single_Room","DoubleBed-Room","Family_Room"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meal_Plan
			(
				type = radiobuttons
				maxchar = 100
				values = {"Breakfast Combo","Naan with butter chicken","Chicken 65 Briyani"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Amenities_Required
			(
				type = list	
				values = {"Makeup_kit","Hot water service for 24 hrs","Body_Spa"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Agree_To_Hotel_Policies
			(
				type = checkboxes	
				values = {"CheckIn and CheckOut Time should be follow","Non cancellation"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Requires_Airport_Pickup
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hotel_Policies_Display
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Travel_Itinerary_URL
			(
    			type = url
				enable  linkname
	 			row = 1
	 			column = 1   
				width = medium
			)
			Guest_Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Loyalty_Discount_Percent
			(
    			type = percentage
	 			row = 1
	 			column = 1   
				width = medium
			)
			Advance_Payment_Paid
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Distance_From_Airport_KM
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Booking_Submitted_On
			(
    			type = datetime
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Additional_Guests_Details
			(
				type = grid
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Room_Booking_Form
			(
				type = picklist	
				values  = Room_Booking_Form.ID
    			displayformat = [Room_Type]
				sortorder = ascending
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Additional_Guests_Details1
			(
    			type = signature
				displayname = "Guest_Digital_Signature"
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			Section3
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			ID_Proof_Upload
			(
    			type = upload file
				browse = local_drive
	 			row = 5
	 			column = 1   
				width = medium
			)
			Section4
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Special_Request_Voice_Note
			(
     			type = audio
    			duration=60
	 			row = 6
	 			column = 1   
				width = medium
			)
			Celebration_Request_Video
			(
    			type = video
    			duration=30
	 			row = 6
	 			column = 1   
				width = medium
			)
			Booking_ID
			(
    			type = autonumber
				start index = 3
	 			row = 6
	 			column = 1   
				width = medium
			)
			Section5
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			Total_Amount_Payable
			(
				type = number
	 			row = 7
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Number_Of_Guests * 10
    						visibility = false
    			)
			)
			Section6
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "QR Code"
				value = "${ID_Proof_Number}${ID_Proof_Upload}"
	 			row = 8
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Enquiry","Confirmed","Checked-In","Checked-Inn","Checked-Out","Checked-outt","cancelled"}
			}
		}
	}
	reports
	{
		default list Room_Booking_Form_Report
		{
			displayName = "Room_Booking_Form Report"
			show all rows from Room_Booking_Form    
			(
				Guest_name 
				Email_Address
				Permanent_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				ID_Proof_Number
				Special_Requests
				Number_Of_Guests
				Check_In_Date
				Preferred_CheckIn_Time
				Room_Type
				Meal_Plan
				Amenities_Required
				Agree_To_Hotel_Policies
				Requires_Airport_Pickup
				Hotel_Policies_Display
				Travel_Itinerary_URL
				Guest_Photo
				Loyalty_Discount_Percent
				Advance_Payment_Paid
				Distance_From_Airport_KM
				Booking_Submitted_On
				Room_Booking_Form
				Additional_Guests_Details1 as "Guest_Digital_Signature"
				ID_Proof_Upload
				Special_Request_Voice_Note
				Celebration_Request_Video
				Booking_ID
				Total_Amount_Payable
				QR_Code as "QR Code"
			)
		}
		list All_Bookings_List
		{
			displayName = "All_Bookings_List"
			show all rows from Room_Booking_Form    
			(
				Guest_name 
				Email_Address
				Permanent_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				ID_Proof_Number
				Special_Requests
				Number_Of_Guests
				Check_In_Date
				Preferred_CheckIn_Time
				Room_Type
				Meal_Plan
				Amenities_Required
				Agree_To_Hotel_Policies
				Requires_Airport_Pickup
				Hotel_Policies_Display
				Travel_Itinerary_URL
				Guest_Photo
				Loyalty_Discount_Percent
				Advance_Payment_Paid
				Distance_From_Airport_KM
				Booking_Submitted_On
				Room_Booking_Form
				Additional_Guests_Details1 as "Guest_Digital_Signature"
				ID_Proof_Upload
				Special_Request_Voice_Note
				Celebration_Request_Video
				Booking_ID
				Total_Amount_Payable
				QR_Code as "QR Code"
			)
		}
		spreadsheet Bookings_Spreadsheet
		{
			displayName = "Bookings_Spreadsheet"
			show all rows from Room_Booking_Form    
			(
				Guest_name 
				Email_Address
				Permanent_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				ID_Proof_Number
				Special_Requests
				Number_Of_Guests
				Check_In_Date
				Preferred_CheckIn_Time
				Room_Type
				Meal_Plan
				Amenities_Required
				Agree_To_Hotel_Policies
				Requires_Airport_Pickup
				Hotel_Policies_Display
				Travel_Itinerary_URL
				Guest_Photo
				Loyalty_Discount_Percent
				Advance_Payment_Paid
				Distance_From_Airport_KM
				Booking_Submitted_On
				Room_Booking_Form
				Additional_Guests_Details1 as "Guest_Digital_Signature"
				ID_Proof_Upload
				Special_Request_Voice_Note
				Celebration_Request_Video
				Booking_ID
				Total_Amount_Payable
				QR_Code as "QR Code"
			)
		}
		kanban Booking_Status_Kanban
		{
			displayName = "Booking_Status_Kanban"
			show all rows from Room_Booking_Form    
			(
				Guest_name 
				Email_Address
				Permanent_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				ID_Proof_Number
				Special_Requests
				Number_Of_Guests
				Check_In_Date
				Preferred_CheckIn_Time
				Room_Type
				Meal_Plan
				Amenities_Required
				Agree_To_Hotel_Policies
				Requires_Airport_Pickup
				Hotel_Policies_Display
				Travel_Itinerary_URL
				Guest_Photo
				Loyalty_Discount_Percent
				Advance_Payment_Paid
				Distance_From_Airport_KM
				Booking_Submitted_On
				Room_Booking_Form
				Additional_Guests_Details1 as "Guest_Digital_Signature"
				ID_Proof_Upload
				Special_Request_Voice_Note
				Celebration_Request_Video
				Booking_ID
				Total_Amount_Payable
				QR_Code as "QR Code"
			)
			options
			(
	 			display field = Room_Type
	 		)
		}
		calendar Checkin_Schedule_Calendar
		{
			displayName = "Checkin_Schedule_Calendar"
			show all rows from Room_Booking_Form    
			(
				Additional_Guests_Details1 as "Guest_Digital_Signature"
				Agree_To_Hotel_Policies
				Celebration_Request_Video
				Booking_ID
				Permanent_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Email_Address
				ID_Proof_Upload
				Special_Request_Voice_Note
				Guest_name 
				Amenities_Required
				Room_Booking_Form
				Distance_From_Airport_KM
				Number_Of_Guests
				Added_Time as "Added Time"
				Booking_Submitted_On
				Check_In_Date
				Loyalty_Discount_Percent
				ID_Proof_Number
				Advance_Payment_Paid
				Special_Requests
				Meal_Plan
				Preferred_CheckIn_Time
				Room_Type
				Total_Amount_Payable
				QR_Code as "QR Code"
				Travel_Itinerary_URL
				Guest_Photo
				Requires_Airport_Pickup
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Hotel_Policies_Display
			)
			options
			(
				display field = Check_In_Date
				start date = Check_In_Date
				end date = Added_Time
			)
		}
		map Guest_Origin_Map
		{
			displayName = "Guest_Origin_Map"
			show all rows from Room_Booking_Form    
			(
				Guest_name 
				Email_Address
				Permanent_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				ID_Proof_Number
				Special_Requests
				Number_Of_Guests
				Check_In_Date
				Preferred_CheckIn_Time
				Room_Type
				Meal_Plan
				Amenities_Required
				Agree_To_Hotel_Policies
				Requires_Airport_Pickup
				Hotel_Policies_Display
				Travel_Itinerary_URL
				Guest_Photo
				Loyalty_Discount_Percent
				Advance_Payment_Paid
				Distance_From_Airport_KM
				Booking_Submitted_On
				Room_Booking_Form
				Additional_Guests_Details1 as "Guest_Digital_Signature"
				ID_Proof_Upload
				Special_Request_Voice_Note
				Celebration_Request_Video
				Booking_ID
				Total_Amount_Payable
				QR_Code as "QR Code"
			)
			options
			(
	 			display field = Permanent_Address
	 		)
		}
		timeline Booking_Activity_Timeline
		{
			displayName = "Booking_Activity_Timeline"
			show all rows from Room_Booking_Form    
			(
				Guest_name 
				Email_Address
				Permanent_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				ID_Proof_Number
				Special_Requests
				Number_Of_Guests
				Check_In_Date
				Preferred_CheckIn_Time
				Room_Type
				Meal_Plan
				Amenities_Required
				Agree_To_Hotel_Policies
				Requires_Airport_Pickup
				Hotel_Policies_Display
				Travel_Itinerary_URL
				Guest_Photo
				Loyalty_Discount_Percent
				Advance_Payment_Paid
				Distance_From_Airport_KM
				Booking_Submitted_On
				Room_Booking_Form
				Additional_Guests_Details1 as "Guest_Digital_Signature"
				ID_Proof_Upload
				Special_Request_Voice_Note
				Celebration_Request_Video
				Booking_ID
				Total_Amount_Payable
				QR_Code as "QR Code"
			)
			options
			(
				display field = Booking_Submitted_On
				start date = Booking_Submitted_On
				end date = Check_In_Date
			)
		}
	}
	pages
	{
		page Hotel_Command_Center_Page
		{
			displayname = "Hotel_Command_Center_Page"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<search \n\telementName='Search'\n\tpaddingTop = '40px'\n\tpaddingLeft = '80px'\n\tpaddingRight = '80px'\n\tpaddingBottom = '40px'\n\tbgtype = 'none'\n\tbgColor = '#FFFFFF'\n\n\tshape = 'flat'\n\tresultComponent = 'report'\n\tlinkName = 'Bookings_Spreadsheet'\n\ttarget = 'new-window'\n\tcriteriaString = 'Guest_name.first_name.contains(input.searchString)'\n\tfontFamily = 'default'\n\tappLinkName = 'thisapp'\n\tstyle = '1'\n\tplaceholder = 'Enter value'\n\n>\n<searchbar color=\"#000000\" bgColor=\"#FFFFFF\" fontSize=\"15px\"\n/></search>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<board\n    \n\tbgColor = '#FFFFFF'\n        bgColorType = 'solid'\n\tpadding = '0px'\nelementName='Board'\n    layoutType = 'grid'\n        items = '1'\n    appLinkName = 'thisapp'\n    formLinkName = 'Room_Booking_Form'\n    rankBy = 'ID'\n    rankOrder = 'highestToLowest'\n    rankAggregate = 'count'\n    limit = '3'\n    groupBy = 'Room_Booking_Form.Room_Type'\n>\n<boardHeader>\n    <pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '14px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '14px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#000000'\n\tsize = '17px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Course Completion by Department'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</boardHeader>\n<boardLayout\n                paddingRight = '15px'\n                paddingBottom = '15px'\n                paddingLeft = '20px'\n                bgColor = '#A6A6A6'\n                paddingTop = '2px'\n                itemGap = '10px'\n>\n    <pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingLeft = '20px'\n\tpaddingRight = '20px'\n\n    borderColor = '#F2F2F2'\n    borderWidth = '1px'\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '12px'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '10px'\n\tpaddingBottom = '10px'\n\n\t\twidth = '70%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '19px'\n\tbold = 'true' \n\ttype = 'boardData'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n    lineHeight = '26'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'rank'\n>\n</text>\n\n</pc><pc \n\t\n>\n\t<image  \n\t\tmarginLeft = '20px'\n\n\tcolor = '#000000'\n\tbgColor = '#F7F7FB'\n\twidth = '36px'\n\theight = '36px'\n\ttype = 'icon'\n\tvalue = 'education-books-46'\n\tsize = '20px'\n\tcornerRadius = '18px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n>\n\t<text \n\n\tmarginLeft = '15px'\n\tcolor = '#000000'\n\tsize = '16px'\n\ttype = 'boardData'\n\n\n    lineHeight = '22'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'groupedField'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\tpaddingTop = '10px'\n\tpaddingBottom = '10px'\n\n\t\twidth = '30%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = 'theme'\n\tsize = '17px'\n\tbold = 'true' \n\ttype = 'boardData'\n\n\n    lineHeight = '23'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'rankAggregate'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</boardLayout>\n</board>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<panel elementName='Board'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = '2'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = '#FFBCC1'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#B8B8B8'\n    borderWidth = '0px'\n\n\t  value = 'NUMBER OF CUSTOMERS'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Line'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Room_Booking_Form'\n\txfield = 'Check_In_Date'\n\tyfields = 'sum:Advance_Payment_Paid'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<gauge \n\telementName='Occupancy_Rate_Gauge'\n\n\tcolor = '#000000'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = '#0BD6B1'\n\tdisplayType = 'actual'\n\ttype = '1'\n\tfilledColor = '#0BD6B1'\n\tnonFilledColor = '#F5F5F5'\n\tneedleColor = '#000000'\n\ttargetColor = '#D8D8D8'\n\tvalue = 'thisapp.Room_Booking_Form.Room_Booking_Form.Number_Of_Guests.max'\n>\n<target size=\"15px\" color=\"#7F7F7F\" fontFamily=\"default\" value=\"30\"\n/><maximumvalue size=\"15px\" color=\"#7F7F7F\" value=\"45\" \n/>\n</gauge>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dspZml id='zml_snippet' elementName='ZML Snippet'\n>\n\t<![CDATA[htmlpage zml_snippet()\ncontent\n&lt;%{\n\t%&gt;\n&lt;panel&gt; &lt;/panel&gt;\n&lt;%\n\n}%&gt;]]>\n</dspZml>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<form \n\telementName='Full_Bookings_Report'\n\n\tappLinkName = 'thisapp'\n\tlinkName = 'Room_Booking_Form'\n\theightType = 'auto'\n\turlType = 'none'\n\tzc_Header = 'false'\n/> \n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Send_Checkin_Reminder_Button'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\tvAlign = 'middle'\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n\tcolor = 'theme'\n\tsize = '16px'\n    borderColor = 'theme'\n    borderWidth = '1px'\n\ttext ='Check-in reminder'\n\t\tbgColor = 'transparent'\n            bgColorType = 'noFill'\n\t\tcornerRadius = '60px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</layout>\n</zml>"
