		workflow
		{
		form
		{
			Send_Email_Form_Propertie as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Room_Booking_Form
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address
							subject : "assignment _hotelform : New entry added"
							message : "<div>Hello,<br><br>A new entry added in 'Room_Booking_Form' form of 'assignment _hotelform' application.<br></div>"
							attachments : template : _default as inline
						)
					}
				}
			}
			On_Booking_Submit_Workflo as "On_Booking_Submit_Workflow"
			{
				type =  form
				form = Room_Booking_Form

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.loginuserid"
							subject : "Booking status"
							message : "<div>${zoho.loginuserid} has added a record in form Room_Booking_Form<br></div>"
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Checkin_Reminder_Sc as "Daily_Checkin_Reminder_Schedule"
			{
				type =  schedule
					status = inactive
				start = "2026-08-21 06:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
				}
			}
		}

		approval
		{
			Complimentary_Upgrade_App as "Complimentary_Upgrade_Approval"
			{
				type =  approval
				form = Room_Booking_Form[Special_Requests is null]
				display fields = [Guest_name,Email_Address,Permanent_Address,Contact_Number,ID_Proof_Number,Special_Requests,Number_Of_Guests]
				on start
				{
				}
				on level 1
				{
					approvers
					(
			 			role = "CEO"
					)
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}

		blueprint
		{
    			Booking_Lifecycle_Bluepri as "Booking_Lifecycle_Blueprint"
    			{
        			type = Blueprint
        			form = Room_Booking_Form
        			start
        			{
        			}
        			stages
        			{
        			}
        			transitions
        			{
        			}
    			}
		}

		batchworkflow
		{
			Bulk_Feedback_Request_Bat
			{
    			display name = "Bulk_Feedback_Request_Batch"
    			type = batchworkflow
    			form = Room_Booking_Form
    			event = "On Schedule"
    			start = "21-Aug-2026 23:23:23"
    			frequency = once
    			batch size = 1000
    			status = active
			}
		}

	}
